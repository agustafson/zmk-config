/* 29 horizontal chord shapes. Top/home/bottom; no vertical combos. */
#ifndef COMBO_TERM_FAST
#define COMBO_TERM_FAST 18
#endif
#ifndef COMBO_IDLE_FAST
#define COMBO_IDLE_FAST 150
#endif

ZMK_COMBO(esc, &kp ESC, LT3 LT2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
/* Do not intercept 8+9 when the numpad layer is active. */
ZMK_COMBO(grave, &kp GRAVE, LT2 LT1, DEF NAV, 50, 0)
ZMK_COMBO(at, &kp AT, LT3 LT1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(fence, &direct_fence, LT3 LT2 LT1, DEF, 50, 0)
ZMK_COMBO(dllr, &kp DLLR, LT4 LT3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(tab, &kp, TAB, LM3 LM2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LS(LALT), KEYS_R)
ZMK_COMBO(shift_cmd, &none, LM2 LM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LS(LGUI), KEYS_R)
ZMK_COMBO(equal, &kp, EQUAL, LM3 LM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LA(LGUI), KEYS_R)
ZMK_COMBO(shift_opt_cmd, &none, LM3 LM2 LM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LS(LA(LGUI)), KEYS_R)
ZMK_COMBO(prcnt, &kp, PRCNT, LM4 LM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LC(LALT), KEYS_R)
ZMK_COMBO(copy, &kp LG(C), LB3 LB2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(paste, &kp LG(V), LB2 LB1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(cut, &kp LG(X), LB3 LB1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(bslh, &kp BSLH, LB3 LB2 LB1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(undo, &kp LG(Z), LB4 LB3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(hash, &kp HASH, RT1 RT2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(star, &kp STAR, RT2 RT3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(plus, &kp PLUS, RT1 RT3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(amps, &kp AMPS, RT3 RT4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lpar, &lpar_lt, RM1 RM2, DEF NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, RS(LGUI), KEYS_L)
ZMK_COMBO(rpar, &rpar_gt, RM2 RM3, DEF NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, RS(LALT), KEYS_L)
ZMK_COMBO(minus, &kp, MINUS, RM1 RM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LG(LALT), KEYS_L)
ZMK_COMBO(under, &kp, UNDER, RM1 RM2 RM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, RS(LG(LALT)), KEYS_L)
ZMK_COMBO(caret, &kp, CARET, RM3 RM4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST, LA(LCTRL), KEYS_L)
ZMK_COMBO(lbkt, &kp LBKT, RB1 RB2, DEF NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt, &kp RBKT, RB2 RB3, DEF NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(fslh, &kp FSLH, RB1 RB3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(pipe, &kp PIPE, RB1 RB2 RB3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(tilde, &kp TILDE, RB3 RB4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* Nav alternatives keep the same chord shapes. */
ZMK_COMBO(lt, &kp LT, RM1 RM2, NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(gt, &kp GT, RM2 RM3, NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbrc, &kp LBRC, RB1 RB2, NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc, &kp RBRC, RB2 RB3, NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
