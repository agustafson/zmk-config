#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&num_word { ignore-modifiers; };
/ {
    behaviors {
        layout_select: layout_select { compatible = "custom,behavior-layout-select"; #binding-cells = <1>; };
        numword_taps: numword_taps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&num_word 4>;
        };
        smart_sym: smart_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            bindings = <&mo>, <&numword_taps>;
        };
        fence: fence { compatible = "custom,behavior-fence"; #binding-cells = <0>; };
        combo_fence: combo_fence { compatible = "custom,behavior-combo-fence"; #binding-cells = <0>; };
        direct_fence: direct_fence { compatible = "custom,behavior-direct-fence"; #binding-cells = <0>; };
        fence_finish: fence_finish { compatible = "custom,behavior-fence-finish"; #binding-cells = <0>; };
        // Opposite-hand chords resolve as holds; same-hand rolls stay taps.
        hm_l: home_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hm_r: home_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };
    // Base Colemak positions: Z=21, X=22, C=23, V=24.
    // Brief idle reduces accidental shortcuts while typing e.g. "exception".
    combos {
        compatible = "zmk,combos";
        // The overlapping W+F+P and F+P combos use the physical Colemak positions.
        // No idle guard: backtick and Backspace must work immediately after typing.
        combo_fenced_block { key-positions = <1 2 3>; bindings = <&direct_fence>; timeout-ms = <50>; layers = <0>; };
        combo_grave  { key-positions = <2 3>; bindings = <&kp GRAVE>; timeout-ms = <50>; layers = <0>; };
        combo_bspc   { key-positions = <6 7>; bindings = <&kp BSPC>; timeout-ms = <50>; layers = <0>; };
        combo_undo {
            key-positions = <21 22>;
            bindings = <&kp LG(Z)>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
        combo_copy {
            key-positions = <22 23>;
            bindings = <&kp LG(C)>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
        combo_paste {
            key-positions = <23 24>;
            bindings = <&kp LG(V)>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
    };
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <5 6>;
            then-layer = <7>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        colemak {
            bindings = <
                &kp Q  &kp W  &kp F  &kp P  &kp G  &kp J  &kp L  &kp U  &kp Y  &kp SEMI
                &hm_l LCTRL A  &hm_l LALT R  &hm_l LGUI S  &hm_l LSHIFT T  &kp D  &kp H  &hm_r RSHIFT N  &hm_r RGUI E  &hm_r RALT I  &hm_r RCTRL O
                &kp LC(LA(LS(LGUI)))  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp K  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                &kp ESC  &kp BSPC  &smart_sym 5 0  &mo 6  &kp ENTER  &kp SPACE
            >;
        };
        colemak_dh {
            bindings = <
                &kp Q  &kp W  &kp F  &kp P  &kp B  &kp J  &kp L  &kp U  &kp Y  &kp SEMI
                &hm_l LCTRL A  &hm_l LALT R  &hm_l LGUI S  &hm_l LSHIFT T  &kp G  &kp M  &hm_r RSHIFT N  &hm_r RGUI E  &hm_r RALT I  &hm_r RCTRL O
                &kp LC(LA(LS(LGUI)))  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                &kp ESC  &kp BSPC  &smart_sym 5 0  &mo 6  &kp ENTER  &kp SPACE
            >;
        };
        graphite {
            bindings = <
                &kp B  &kp L  &kp D  &kp W  &kp Z  &kp SQT  &kp F  &kp O  &kp U  &kp J
                &hm_l LCTRL N  &hm_l LALT R  &hm_l LGUI T  &hm_l LSHIFT S  &kp G  &kp Y  &hm_r RSHIFT H  &hm_r RGUI A  &hm_r RALT E  &hm_r RCTRL I
                &kp LC(LA(LS(LGUI)))  &kp Q  &kp X  &kp M  &kp C  &kp V  &kp K  &kp P  &kp DOT  &kp COMMA  &kp FSLH  &kp SQT
                &kp ESC  &kp BSPC  &smart_sym 5 0  &mo 6  &kp ENTER  &kp SPACE
            >;
        };
        gallium {
            bindings = <
                &kp B  &kp L  &kp D  &kp C  &kp V  &kp J  &kp Y  &kp O  &kp U  &kp COMMA
                &hm_l LCTRL N  &hm_l LALT R  &hm_l LGUI T  &hm_l LSHIFT S  &kp G  &kp P  &hm_r RSHIFT H  &hm_r RGUI A  &hm_r RALT E  &hm_r RCTRL I
                &kp LC(LA(LS(LGUI)))  &kp X  &kp Q  &kp M  &kp W  &kp Z  &kp K  &kp F  &kp SQT  &kp SEMI  &kp DOT  &kp SQT
                &kp ESC  &kp BSPC  &smart_sym 5 0  &mo 6  &kp ENTER  &kp SPACE
            >;
        };
        numword {
            bindings = <
                &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp PLUS  &trans  &trans  &trans  &trans  &trans
                &trans  &hm_l LALT N4  &hm_l LGUI N5  &hm_l LSHIFT N6  &kp N0  &trans  &trans  &trans  &trans  &trans
                &trans  &kp MINUS  &kp N1  &kp N2  &kp N3  &kp DOT  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        symbols {
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &kp UNDER  &kp LBRC  &kp RBRC  &kp LBKT  &kp RBKT  &kp COLON  &kp LPAR  &kp RPAR  &kp LT  &kp GT
                &trans  &kp SEMI  &kp BSLH  &kp PIPE  &kp GRAVE  &kp DQT  &kp PLUS  &kp MINUS  &kp EQUAL  &kp ASTRK  &kp FSLH  &trans
                &kp LSHIFT  &trans  &trans  &trans  &trans  &kp RSHIFT
            >;
        };
        navigation {
            bindings = <
                &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp PLUS  &kp PG_UP  &kp HOME  &kp UP  &kp END  &kp PG_DN
                &trans  &hm_l LALT N4  &hm_l LGUI N5  &hm_l LSHIFT N6  &kp N0  &kp LA(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LA(RIGHT)
                &trans  &kp MINUS  &kp N1  &kp N2  &kp N3  &kp DOT  &kp DEL  &kp HOME  &kp END  &kp PG_UP  &kp PG_DN  &trans
                &trans  &trans  &trans  &trans  &trans  &kp TAB
            >;
        };
        system {
            bindings = <
                &layout_select 0  &layout_select 1  &layout_select 2  &layout_select 3  &none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
                &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHIFT  &caps_word  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &kp TAB  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp F11  &kp F12  &none  &none  &none  &kp DEL
                &kp ESC  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
